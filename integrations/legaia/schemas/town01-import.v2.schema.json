{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psxrecomp.dev/schemas/legaia/town01-import.v2.json",
  "title": "Legaia metadata-only scene import with model asset identities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "importer_version", "source", "scene", "actors", "assets", "diagnostics", "unresolved"],
  "properties": {
    "schema_version": {"const": "legaia.scene-import.v2"},
    "importer_version": {"type": "string"},
    "source": {"type": "object"},
    "scene": {"type": "object"},
    "actors": {"type": "array", "items": {"$ref": "#/$defs/actor"}},
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models"],
      "properties": {
        "models": {"type": "array", "items": {"$ref": "#/$defs/modelAsset"}}
      }
    },
    "diagnostics": {"type": "array", "items": {"type": "object"}},
    "unresolved": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "actorSourceRecord": {
      "type": "object",
      "required": ["iso_file", "prot_entry_index", "scene_bundle", "record_kind", "record_index", "byte_offset", "byte_length", "byte_coordinate_space", "containing_decoded_size"],
      "properties": {
        "iso_file": {"const": "PROT.DAT"},
        "prot_entry_index": {"type": "integer", "minimum": 0},
        "scene_bundle": {"type": "object"},
        "record_kind": {"const": "man_partition_1_actor_placement"},
        "record_index": {"type": "integer", "minimum": 1},
        "byte_offset": {"type": "integer", "minimum": 0},
        "byte_length": {"type": "integer", "minimum": 1},
        "byte_coordinate_space": {"const": "decoded_man_payload"},
        "containing_decoded_size": {"type": "integer", "minimum": 1}
      }
    },
    "modelSourceRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["disc", "iso_file", "prot_entry_index", "prot_entry_name", "record_kind", "byte_offset", "byte_length", "byte_coordinate_space", "containing_size", "object_count"],
      "properties": {
        "disc": {"type": "object"},
        "iso_file": {"const": "PROT.DAT"},
        "prot_entry_index": {"type": "integer", "minimum": 0},
        "prot_entry_name": {"type": "string"},
        "record_kind": {"enum": ["raw_prot_entry", "decoded_lzs_section", "decoded_tmd_pack_slot"]},
        "byte_offset": {"type": "integer", "minimum": 0},
        "byte_length": {"type": "integer", "minimum": 1},
        "byte_coordinate_space": {"enum": ["prot_entry", "decoded_lzs_section"]},
        "containing_size": {"type": "integer", "minimum": 1},
        "object_count": {"type": "integer", "minimum": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "value", "confidence", "evidence", "source", "notes"],
      "properties": {
        "property": {"type": "string"},
        "value": {},
        "confidence": {"enum": ["confirmed", "strongly_inferred", "tentative", "unknown", "contradictory"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "source": {"type": "object"},
        "notes": {"type": "string"}
      }
    },
    "modelReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_entry", "model_index", "normalized_pool_index", "model_pool", "asset_semantic_id", "referenced_asset_record", "resolution_status"],
      "properties": {
        "source_entry": {"type": ["integer", "null"], "minimum": 0},
        "model_index": {"type": "integer", "minimum": 0, "maximum": 255},
        "normalized_pool_index": {"type": "integer", "minimum": 0},
        "model_pool": {"enum": ["scene_tmd", "global_special"]},
        "asset_semantic_id": {"type": ["string", "null"]},
        "referenced_asset_record": {"type": ["string", "null"]},
        "resolution_status": {"enum": ["resolved", "pool_index_out_of_bounds"]}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_id", "source_record", "imported_transform", "model_reference", "placement_fields", "claims", "unresolved"],
      "properties": {
        "semantic_id": {"type": "string", "pattern": "^scene://town01/actors/man-p1/[0-9]{4,}$"},
        "source_record": {"$ref": "#/$defs/actorSourceRecord"},
        "imported_transform": {"type": "object"},
        "model_reference": {"$ref": "#/$defs/modelReference"},
        "placement_fields": {"type": "object"},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "unresolved": {"type": "array", "items": {"type": "string"}}
      }
    },
    "modelAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_id", "asset_kind", "scope", "model_pool", "encoded_model_index", "normalized_pool_index", "source_record", "claims", "dependencies", "aliases", "unresolved"],
      "properties": {
        "semantic_id": {"type": "string", "pattern": "^asset://(town01/models/scene-tmd/[0-9]{4,}|legaia/models/global-special/00f[0-9a-f])$"},
        "asset_kind": {"const": "tmd_model"},
        "scope": {"enum": ["scene", "global"]},
        "model_pool": {"enum": ["scene_tmd", "global_special"]},
        "encoded_model_index": {"type": "integer", "minimum": 0, "maximum": 255},
        "normalized_pool_index": {"type": "integer", "minimum": 0},
        "source_record": {"$ref": "#/$defs/modelSourceRecord"},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "dependencies": {"type": "array"},
        "aliases": {"type": "array"},
        "unresolved": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
